# Copy to .env and fill in. Never commit .env.
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/ved
JWT_SECRET=

# Public https URL of this backend. Plivo XML and signature checks use it.
PUBLIC_BASE_URL=
# Comma-separated dashboard origin(s) allowed by CORS, e.g. https://ved.vercel.app
DASHBOARD_ORIGIN=

# Speech to text and the LLM
GROQ_API_KEY=

# Voice. Without these the free Google voice is used.
ELEVENLABS_API_KEY=
# e.g. Nda1Ovn4Zg0G77HVF1Fz (Rida M, Hindi support agent) or 5tVHtUzsvCIP0aBhFUne (Anjura)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Plivo (docs/PLIVO_SETUP.md)
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
# Only for local testing without real Plivo requests:
# PLIVO_VERIFY_SIGNATURE=false

# Turn-taking tuning (optional)
# VAD_SPEECH_RMS=600
# VAD_END_SILENCE_MS=700

# Legacy telephony, removed once Plivo is live
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
