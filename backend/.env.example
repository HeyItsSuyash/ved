# Copy to .env and fill in. Never commit .env.
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/ved
JWT_SECRET=

# Public https URL of this backend, used in telephony webhooks
SERVER_URL=

GROQ_API_KEY=

# Telephony (current). Plivo replaces these, see docs/ARCHITECTURE.md
TELEPHONY_PROVIDER=exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
