# Copy to .env and fill in. Never commit .env.
PORT=3001
# Supabase: Connect > Session pooler (port 5432), with your database password
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Optional: connection for schema changes. Derived from DATABASE_URL when empty
# (Supabase transaction pooler 6543 -> session pooler 5432).
DIRECT_URL=
JWT_SECRET=
# First dashboard login, created on startup if missing (useful where there is no shell)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public https URL of this backend. Plivo XML and signature checks use it.
PUBLIC_BASE_URL=
# Comma-separated dashboard origin(s) allowed by CORS, e.g. https://ved.vercel.app
DASHBOARD_ORIGIN=

# Speech to text and the LLM
GROQ_API_KEY=

# Voice. Without these the free Google voice is used.
ELEVENLABS_API_KEY=
# Voice type, tone and speed are chosen in the dashboard (Agent > Voice).
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Plivo (docs/PLIVO_SETUP.md)
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
# Only for local testing without real Plivo requests:
# PLIVO_VERIFY_SIGNATURE=false

# Local development only: print verification codes instead of calling staff phones
# OTP_DELIVERY=log

# Turn-taking tuning (optional)
# VAD_SPEECH_RMS=600
# VAD_END_SILENCE_MS=700

# Legacy telephony, removed once Plivo is live
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
