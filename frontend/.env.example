# Copy to .env.local for local development; set the same on Vercel.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Plivo fallback answer URL (app/api/plivo-fallback): rings staff if the backend is down.
# Configure on the Plivo application as https://<dashboard>/api/plivo-fallback?key=<PLIVO_FALLBACK_KEY>
PLIVO_NUMBER=
PLIVO_FALLBACK_KEY=
PLIVO_FALLBACK_NUMBERS=
